[Unit]
Description=Зашифрованное резервное копирование персонального агента
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/personal-agent.conf
ExecStart=/bin/bash -lc 'cd "$PERSONAL_AGENT_PROJECT_DIR" && exec ./scripts/backup.sh'
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

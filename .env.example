# Скопируйте этот файл в .env и замените все значения PLACEHOLDER.
# Формат должен оставаться совместимым с POSIX shell: для пробелов используйте кавычки.

# Фиксированная версия официального образа. Не используйте latest.
OPENCLAW_VERSION=2026.7.1-2
# Необязательный override полного image reference, например с digest.
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw@sha256:PLACEHOLDER_DIGEST

# Сгенерируйте: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=PLACEHOLDER_GENERATE_RANDOM_TOKEN
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_TZ=Asia/Yekaterinburg

# OpenRouter и логические роли моделей.
# Формат: openrouter/<поставщик>/<модель> или openrouter/auto.
OPENROUTER_API_KEY=PLACEHOLDER_OPENROUTER_API_KEY
PRIMARY_MODEL=openrouter/auto
UTILITY_MODEL=openrouter/auto
HEAVY_MODEL=openrouter/auto

# Telegram. Токен создаётся вручную через BotFather.
TELEGRAM_BOT_TOKEN=PLACEHOLDER_TELEGRAM_BOT_TOKEN

# Абсолютные каталоги будущего сервера.
PERSONAL_AGENT_DATA_DIR=/srv/personal-agent/state
PERSONAL_AGENT_BACKUP_DIR=/srv/personal-agent/backups
# UID/GID пользователя node внутри официального image. Для работы без sudo
# deployment-пользователь host-машины должен иметь тот же UID.
OPENCLAW_UID=1000
OPENCLAW_GID=1000

# Ограничения контейнера. Значения должны поддерживаться Docker Compose.
OPENCLAW_MEMORY_LIMIT=4g
OPENCLAW_CPU_LIMIT=2.0
OPENCLAW_LOG_MAX_SIZE=10m
OPENCLAW_LOG_MAX_FILE=5
HEALTHCHECK_TIMEOUT_SECONDS=120

# Зашифрованный удалённый репозиторий restic.
# Например: s3:https://1234567890abcdef.r2.cloudflarestorage.com/personal-agent-backups/restic
RESTIC_REPOSITORY=PLACEHOLDER_RESTIC_REPOSITORY
RESTIC_PASSWORD_FILE=/srv/personal-agent/secrets/restic-password
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# При необходимости раскомментируйте переменные выбранного backend restic.
# AWS_ACCESS_KEY_ID=PLACEHOLDER
# AWS_SECRET_ACCESS_KEY=PLACEHOLDER
# AWS_DEFAULT_REGION=auto
# B2_ACCOUNT_ID=PLACEHOLDER
# B2_ACCOUNT_KEY=PLACEHOLDER
# RESTIC_REST_USERNAME=PLACEHOLDER
# RESTIC_REST_PASSWORD=PLACEHOLDER

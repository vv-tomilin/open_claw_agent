{
  // Этот файл является исходным шаблоном. prepare-host.sh копирует его в persistent state.
  gateway: {
    mode: "local",
    bind: "lan",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    controlUi: {
      allowedOrigins: ["${OPENCLAW_CONTROL_UI_ORIGIN}"],
    },
  },

  agents: {
    defaults: {
      workspace: "/home/node/.openclaw/workspace",
      model: {
        primary: "${PRIMARY_MODEL}",
        fallbacks: [],
      },
      utilityModel: "${UTILITY_MODEL}",
      models: {
        "openrouter/*": {},
      },
      subagents: {
        model: "${UTILITY_MODEL}",
      },
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "pairing",
      groupPolicy: "disabled",
    },
  },

  // Проект рассчитан на доверенного автономного агента в отдельном контейнере
  // на выделенной машине. Полный профиль включает shell, файловые операции,
  // cron, автоматизации, управление сессиями и доступные инструменты Gateway.
  tools: {
    profile: "full",
  },

  commands: {
    restart: false,
  },
}
